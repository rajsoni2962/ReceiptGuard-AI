# ReceiptGuard AI Environment Variables
PROJECT_NAME="ReceiptGuard AI"
VERSION="1.0.0"
API_V1_STR="/api"

# Database & Storage
DATABASE_URL="sqlite:///./receiptguard.db"
UPLOAD_DIR="./uploads"
CHROMA_PERSIST_DIR="./chroma_db"

# Ollama Integration
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"

# Limits
MAX_UPLOAD_SIZE_MB=10
